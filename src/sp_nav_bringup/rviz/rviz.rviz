Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: sp_nav_tools/FixedGoal
    Name: One-click navigation
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 39; 47
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Alpha: 0.9
      Color Scheme: map
      Topic:
        Value: /global_costmap
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Smoothed global path
      Enabled: true
      Color: 30; 240; 110
      Line Style: Billboards
      Line Width: 0.05
      Pose Style: None
      Topic:
        Value: /global_path
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Raw A-star path
      Enabled: true
      Color: 255; 190; 50
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.04
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Pose Style: None
      Topic:
        Value: /global_path_raw
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Executed trajectory
      Enabled: true
      Color: 65; 170; 255
      Line Style: Billboards
      Line Width: 0.035
      Pose Style: None
      Topic:
        Value: /executed_path
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Controller prediction
      Enabled: true
      Color: 255; 80; 190
      Line Style: Billboards
      Line Width: 0.055
      Pose Style: None
      Topic:
        Value: /mpc_prediction
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: Robot pose
      Enabled: true
      Reference Frame: base_link
      Length: 0.6
      Radius: 0.04
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Start and goal markers
      Enabled: true
      Topic:
        Value: /plan_markers
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 10
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Requested goal
      Enabled: true
      Color: 255; 85; 40
      Shape: Arrow
      Topic:
        Value: /goal_pose
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
      Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down maze
      Target Frame: map
      Scale: 43
      X: 7.5
      Y: 7.5
      Angle: 0
  Enabled: true
Window Geometry:
  Width: 1280
  Height: 850
  X: 20
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: true
